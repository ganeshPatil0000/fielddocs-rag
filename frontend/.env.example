# Copy to .env.local and edit. Vite only exposes variables that start with VITE_.

# Where the FieldDocs API runs. Local: the uvicorn server. Deployed: the api_url Terraform output.
VITE_API_URL=http://localhost:8000

# Leave empty for local mode (API started with AUTH_MODE=none: no sign-in, you are admin).
# Deployed: the cognito_client_id Terraform output.
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=ap-southeast-2
