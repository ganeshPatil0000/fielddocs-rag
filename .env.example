# Local development against real AWS Bedrock + Pinecone.
# Copy to .env; uses your normal AWS credentials (aws configure / SSO).
APP_ENV=local
AUTH_MODE=none
AWS_REGION=ap-southeast-2

LLM_PROVIDER=bedrock
LLM_MODEL_ID=global.amazon.nova-2-lite-v1:0
UTILITY_MODEL_ID=amazon.nova-micro-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# --- or: an OpenAI-compatible API (e.g. AIRouter) instead of Bedrock ---
# Comment out the four Bedrock lines above and use these. The key stays here only.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.airouter.in/v1
# OPENAI_API_KEY=
# LLM_MODEL_ID=amazon/nova-2-lite
# UTILITY_MODEL_ID=amazon/nova-micro
# EMBEDDING_MODEL_ID=amazon/titan-embed-text-v2

VECTOR_STORE=pinecone
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=fielddocs
PINECONE_NAMESPACE=local

# Hybrid search = semantic + keyword (needs the sparse index, see README step 2)
ENABLE_HYBRID_SEARCH=true
PINECONE_SPARSE_INDEX=fielddocs-sparse

# memory = no DynamoDB needed locally
STORAGE_BACKEND=memory

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fielddocs-rag-local
