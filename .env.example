# Local development against real AWS Bedrock + Pinecone.
# Copy to .env; uses your normal AWS credentials (aws configure / SSO).
APP_ENV=local
AUTH_MODE=none
AWS_REGION=us-east-1

LLM_PROVIDER=bedrock
LLM_MODEL_ID=us.amazon.nova-lite-v1:0
UTILITY_MODEL_ID=us.amazon.nova-micro-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

VECTOR_STORE=pinecone
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=fielddocs
PINECONE_NAMESPACE=local

# Hybrid search = semantic + keyword (needs the sparse index, see README step 2)
ENABLE_HYBRID_SEARCH=true
PINECONE_SPARSE_INDEX=fielddocs-sparse

# memory = no DynamoDB needed locally
STORAGE_BACKEND=memory

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fielddocs-rag-local
